# Public URL of the live site — used for canonical URLs, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: where contact-form submissions are forwarded (JSON POST).
# Works with services such as Formspree, Make, Zapier or your own endpoint.
# Leave empty and the form will tell visitors it is not connected yet.
CONTACT_FORM_WEBHOOK_URL=
